# Build context is the repo root so shared/ is available.
# Build stage
FROM golang:1.25.4-bookworm AS build

WORKDIR /app

COPY trader-core/go.mod trader-core/go.sum ./
RUN go mod download

COPY trader-core/ ./
COPY shared/ ./shared/

RUN go build -o api ./cmd/server

# Runtime stage
FROM debian:bookworm-slim

RUN apt-get update \
 && apt-get install -y ca-certificates \
 && update-ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=build /app/api .
COPY --from=build /app/shared ./shared

CMD ["./api"]
